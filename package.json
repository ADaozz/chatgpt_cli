    "pack:min": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^5.4.1",
    "puppeteer-core": "^25.9.0"
