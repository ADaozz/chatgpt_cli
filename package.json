{
  "name": "chatgpt-cli",
  "version": "2.0.0",
  "description": "CLI tool to interact with ChatGPT via Chrome remote debugging (CDP + Puppeteer)",
  "bin": {
    "chatgpt-cli": "./cli.js"
  },
  "homepage": "https://github.com/ADaozz/chatgpt_cli#readme",
  "bugs": {
    "url": "https://github.com/ADaozz/chatgpt_cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADaozz/chatgpt_cli.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "files": [
    "README.md",
    "index.js",
    "cli.js",
    "client.js",
    "commands.js",
    "auto-connect.js",
    "browser.js",
    "renderer.js",
    "theme.js",
    "web-protocol.js",
    "page-controller.js",
    "response-tracker.js",
    "conversation-parser.js",
    "model-controller.js",
    "project-controller.js",
    "file-controller.js",
    "selectors.js",
    "session.js",
    "url-utils.js",
